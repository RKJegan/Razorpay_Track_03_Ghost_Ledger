# ===========================================================================
# Ghost Ledger v2 — environment template
# Copy to .env and fill in. .env is gitignored; NEVER commit real keys.
# All values below are optional: with this file untouched, the system runs
# fully offline against the simulated Razorpay client and the template
# autopsy generator.
# ===========================================================================

# --- Merchant / run config ---
MERCHANT_ID=merchant_demo_001
DATA_SEED=42
LOG_LEVEL=INFO
DB_PATH=data/ghost_ledger.db

# --- Razorpay (TEST MODE ONLY — never live keys) ---
# Leave blank to use the offline simulated client (default).
# Set both AND set RAZORPAY_LIVE_TEST_MODE=1 to call real test-mode endpoints.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_LIVE_TEST_MODE=0
RAZORPAY_TIMEOUT_SECONDS=6.0

# --- LLM autopsy reporter (text only, never in the money path) ---
# Backend: ollama (local) | openai | template (deterministic, no network)
LLM_BACKEND=ollama
LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=12.0
LLM_TEMPERATURE=0.2

# --- Policy engine limits (FR-003) ---
POLICY_MAX_AUTO_APPROVE_INR=10000
POLICY_MAX_ATTEMPTS_PER_FAILURE=3
POLICY_STOP_ON_FAILED_ATTEMPT=3

# --- Ghost Ledger v3: real-time platform (one project, one database) ---
# Master switch for the cause-specific strategy engine. 0 = original v2 behaviour.
ENABLE_ADVANCED_STRATEGIES=0
# Webhook secret from the Razorpay dashboard (Settings > Webhooks). NOT the key secret.
# Leave blank to refuse all webhooks (safe default). Never commit the real value.
RAZORPAY_WEBHOOK_SECRET=
WEBHOOK_MAX_BODY_BYTES=1000000

# --- Operator access (approval queue) and background jobs (A3/A4) ---
# Humans approve/reject high-value recoveries with this key. Set a long random value.
OPERATOR_API_KEY=
# Start the background scheduler with the API (1 for the live demo).
SCHEDULER_ENABLED=0
JOB_SETTLEMENT_POLL_SECONDS=180
JOB_RECONCILE_SECONDS=300
JOB_RETRY_SECONDS=600
JOB_CLEAN_LINKS_SECONDS=900
JOB_BACKOFF_BASE_SECONDS=30
JOB_BACKOFF_MAX_SECONDS=1800
PAYMENT_LINK_EXPIRY_HOURS=24

# --- Ghost Ledger v3 Track B: strategy engine (only read when ENABLE_ADVANCED_STRATEGIES=1) ---
# Dunning sender job interval. Touches are mocked; no customer message is sent in this build.
JOB_DUNNING_SECONDS=900
# Gateway health: rolling window, minimum observations before a verdict, degraded below this rate.
GATEWAY_HEALTH_WINDOW_MINUTES=60
GATEWAY_HEALTH_MIN_SAMPLE=20
GATEWAY_DEGRADED_BELOW=0.80
# A/B test: significance level, minimum units per arm, and opt-in timing experiment.
AB_ALPHA=0.05
AB_MIN_SAMPLE_PER_ARM=100
AB_RETRY_TIMING_EXPERIMENT=0
